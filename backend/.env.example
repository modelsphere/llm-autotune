# Database (compose dev maps postgres to loopback:28432, redis to loopback:28379)
AUTOTUNE_DATABASE_URL=postgresql+asyncpg://autotune:autotune@127.0.0.1:28432/autotune
AUTOTUNE_SYNC_DATABASE_URL=postgresql+psycopg2://autotune:autotune@127.0.0.1:28432/autotune

# Redis (pub/sub for live updates, locks)
AUTOTUNE_REDIS_URL=redis://127.0.0.1:28379/0

# Auth
AUTOTUNE_JWT_SECRET=change-me-in-prod
AUTOTUNE_JWT_EXPIRE_MINUTES=1440

# LLMBench (external benchmark platform)
AUTOTUNE_LLMBENCH_BASE_URL=http://127.0.0.1:28101
# A personal API key (llmb_...) authenticates directly; user/pass is a fallback
AUTOTUNE_LLMBENCH_API_KEY=
AUTOTUNE_LLMBENCH_USERNAME=autotune-service
AUTOTUNE_LLMBENCH_PASSWORD=change-me
AUTOTUNE_LLMBENCH_BENCHMARK_SLUG=perf-suite-v1

# Worker
AUTOTUNE_WORKER_TICK_SECONDS=10
AUTOTUNE_RUN_LOG_DIR=./runs
AUTOTUNE_DEFAULT_MAX_RUN_MINUTES=150
