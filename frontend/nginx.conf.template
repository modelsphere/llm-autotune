server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Re-resolve the API's address at request time rather than caching it
        # once at worker start: a redeploy that recreates the API gives it a
        # new address, and with a static upstream nginx keeps proxying to the
        # dead one until someone restarts this container by hand. A variable in
        # proxy_pass is what forces the lookup to happen per request.
        #
        # The resolver is the container's own, read from /etc/resolv.conf at
        # startup (see 10-resolver.sh), so this one file works behind Docker's
        # embedded DNS and behind a cluster's DNS service alike.
        resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass http://$api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }

    # Hashed build output. A chunk that is not here (a tab still holding the
    # index from before a redeploy asks for an old hash) must be a 404, not
    # index.html served as JavaScript — the app reloads on that failure. The
    # names change with the content, so they can be cached for good.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Everything else is the SPA shell. Never let a browser keep a stale
    # index.html: it names the chunks, and after a redeploy the old ones are gone.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
