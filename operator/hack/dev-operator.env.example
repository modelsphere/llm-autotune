# Local config for hack/dev-operator.sh.
#
# Copy this to hack/dev-operator.env (which is gitignored) and edit it. Nothing
# here — including your kubeconfig path — is committed. Environment variables
# still override these.

# ssh host (or ~/.ssh/config alias) that can reach the cluster API server and
# the image registry. Required.
REMOTE=my-bastion

# Path to the cluster kubeconfig ON that host. Required.
REMOTE_KUBECONFIG=/path/to/cluster.kubeconfig

# Staging dir on the host for the binary + manifests (created if missing).
#REMOTE_DIR=/tmp/autotune-operator

# Operator image to build + push. Defaults to the repo's image if unset.
#IMG=registry.example.com/team/autotune-operator:0.1.0
